# ---------------------------------------------------------------
# GPMP settings (used by both the server and the React client)
#
# Copy this file to ".env" (in the same project folder) and fill in
# the values. The .env file is private: never commit it to Git.
# Only variables starting with VITE_ are visible to the browser code;
# everything else (passwords, JWT_SECRET) stays on the server.
# ---------------------------------------------------------------

# --- Server ---
# The port the Node.js server listens on (the Vite dev server proxies /api to it)
PORT=5000
# "development" while coding, "production" when deployed.
# (Named APP_ENV, not NODE_ENV, so it does not change how Vite builds the React client.)
APP_ENV=development
# The address of the React frontend (used for CORS and in email links)
CLIENT_URL=http://localhost:5173
# Time zone used in notification texts and for "today/tomorrow" in reminders (default Asia/Riyadh)
APP_TIME_ZONE=Asia/Riyadh

# --- MySQL database (XAMPP defaults) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# XAMPP's root user has an empty password by default
DB_PASSWORD=
DB_NAME=gpmp

# --- Login tokens (JWT) ---
# A long random secret (at least 32 characters) used to sign login tokens.
# REPLACE the placeholder below - the server refuses to start with it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# How long a login lasts before the user must sign in again (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# --- Email (SMTP) ---
# Leave SMTP_HOST empty during development: emails are then printed
# to the terminal as "[email preview]" instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GPMP <no-reply@gpmp.edu>"

# --- Frontend (Vite dev server) ---
# Where the Vite dev server forwards /api and /socket.io (the Node.js server above)
VITE_BACKEND_URL=http://localhost:5000
